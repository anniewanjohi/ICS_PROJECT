// backend/modules/calendar/calendarService.js
const { google } = require('googleapis');
const fs = require('fs');
const path = require('path');

class GoogleCalendarService {
    constructor() {
        this.auth = null;
        this.calendar = null;
        this.CREDENTIALS_PATH = path.join(__dirname, '../../credentials.json');
        this.TOKEN_PATH = path.join(__dirname, '../../token.json');
    }

    async init() {
        try {
            const credentials = JSON.parse(fs.readFileSync(this.CREDENTIALS_PATH));
            
            const { client_secret, client_id, redirect_uris } = credentials.installed || credentials.web;
            
            const { OAuth2 } = require('google-auth-library');
            this.auth = new OAuth2(
                client_id,
                client_secret,
                redirect_uris[0] || 'http://localhost'
            );

            if (fs.existsSync(this.TOKEN_PATH)) {
                const token = JSON.parse(fs.readFileSync(this.TOKEN_PATH));
                this.auth.setCredentials(token);
                console.log('✅ Google Calendar token loaded');
            } else {
                console.log('⚠️ No token found. Need to authenticate first.');
                const authUrl = this.getAuthUrl();
                console.log('🔑 Please visit this URL to authorize:', authUrl);
            }

            this.calendar = google.calendar({ version: 'v3', auth: this.auth });
            return this;
        } catch (error) {
            console.error('❌ Failed to initialize Google Calendar:', error.message);
            throw error;
        }
    }

    getAuthUrl() {
        return this.auth.generateAuthUrl({
            access_type: 'offline',
            scope: [
                'https://www.googleapis.com/auth/calendar',
                'https://www.googleapis.com/auth/calendar.events'
            ],
            prompt: 'consent'
        });
    }

    async setToken(code) {
        try {
            const { tokens } = await this.auth.getToken(code);
            this.auth.setCredentials(tokens);
            fs.writeFileSync(this.TOKEN_PATH, JSON.stringify(tokens));
            console.log('✅ Token saved successfully');
            return tokens;
        } catch (error) {
            console.error('❌ Failed to set token:', error.message);
            throw error;
        }
    }

    async createMeetEvent(data) {
        try {
            const { 
                summary = 'SU Directory Appointment',
                description = 'Appointment booked via SU Directory',
                startTime,
                endTime,
                timeZone = 'Africa/Nairobi',
                location,
                attendees = []
            } = data;

            console.log('📅 Creating Google Meet event...');

            const event = {
                summary: summary,
                description: description,
                start: {
                    dateTime: startTime,
                    timeZone: timeZone,
                },
                end: {
                    dateTime: endTime,
                    timeZone: timeZone,
                },
                location: location || 'Online - Google Meet',
                conferenceData: {
                    createRequest: {
                        requestId: `meet-${Date.now()}`,
                        conferenceSolutionKey: { type: 'hangoutsMeet' }
                    }
                },
                attendees: attendees.map(email => ({ email })),
                reminders: {
                    useDefault: false,
                    overrides: [
                        { method: 'email', minutes: 60 },
                        { method: 'popup', minutes: 30 }
                    ]
                }
            };

            const response = await this.calendar.events.insert({
                calendarId: 'primary',
                resource: event,
                conferenceDataVersion: 1,
            });

            const meetLink = response.data.hangoutLink || 
                           response.data.conferenceData?.entryPoints?.[0]?.uri || 
                           null;

            console.log('✅ Google Meet created:', meetLink);

            return {
                success: true,
                eventId: response.data.id,
                meetLink: meetLink,
                event: response.data,
                htmlLink: response.data.htmlLink
            };
        } catch (error) {
            console.error('❌ Failed to create Google Meet event:', error.message);
            return {
                success: false,
                error: error.message,
                meetLink: null
            };
        }
    }

    async deleteMeetEvent(eventId) {
        try {
            await this.calendar.events.delete({
                calendarId: 'primary',
                eventId: eventId,
            });
            console.log('✅ Event deleted:', eventId);
            return { success: true };
        } catch (error) {
            console.error('❌ Failed to delete event:', error.message);
            return { success: false, error: error.message };
        }
    }

    isAuthenticated() {
        return this.auth && this.auth.credentials && this.auth.credentials.access_token;
    }
}

module.exports = GoogleCalendarService;